{%- liquid
  assign enable_locale_selector = section.settings.enable_locale_selector
  assign enable_country_selector = section.settings.enable_country_selector
  assign show_payment_icons = section.settings.show_payment_icons
  assign content = section.blocks

  assign locale_selector = false
  assign country_selector = false
  assign payment_icons = false

  if enable_locale_selector and shop.published_locales.size > 1
    assign locale_selector = true
  endif

  if enable_country_selector and localization.available_countries.size > 1
    assign country_selector = true
  endif

  if show_payment_icons and shop.enabled_payment_types != empty
    assign payment_icons = true
  endif
-%}
<div
  class="footer section"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  style="
    --color-background-input: {{ settings.color_text_footer | color_modify: 'alpha', 0.2 }};
    --color-background-input-hover: {{ settings.color_text_footer | color_modify: 'alpha', 0.25 }};
    --color-background-input-hover-dull: {{ settings.color_text_footer | color_modify: 'alpha', 0.1 }};
    --color-background-input-highlight: {{ settings.color_text_footer | color_modify: 'alpha', 0.35 }};
    --color-text-input: {{ settings.color_text_footer | color_modify: 'alpha', 0.95 }};
  "
>
  <div class="footer__inner">
    <div class="footer__groups">
      {%- for block in content -%}
        {%- assign rendered_image = blank -%}
        {%- if block.settings.image != blank -%}
          {%- capture rendered_image -%}
            {%- render 'image' with image: block.settings.image, wrapper_class: 'footer__image', sizes_px: block.settings.image_max_width -%}
          {%- endcapture -%}
        {%- endif -%}
        <div
          class="
            footer__group
            footer__group--{{ block.type }}
            footer__group--{{ forloop.index }}
            {% if block.settings.collapse_on_mobile and block.settings.title != blank %}footer__group--collapse{% endif %}
            {% if forloop.first %}footer__group--first{% endif %}
            {% if forloop.last %}footer__group--last{% endif %}
            {% unless block.settings.show_title_on_desktop %}hide-title-on-desktop{% endunless %}
          "
          style="
            --desktop-width: {{ block.settings.desktop_width }}%;
            --desktop-padding: {{ block.settings.desktop_padding }}%;
            {% if block.settings.image_max_width %}--image-max-width: {{ block.settings.image_max_width }}px{% endif %}
          "
        >
          {%- if block.settings.title != blank -%}
            <h4 class="footer__header ff-body{% if block.settings.collapse_on_mobile %} footer__header--collapsed{% endif %}">
              <span class="footer__heading fs-accent">{{ block.settings.title }}</span>
            </h4>
            {%- if block.settings.collapse_on_mobile -%}
              <button type="button" class="footer__header ff-body" data-header>
                <span class="footer__heading fs-accent">{{ block.settings.title }}</span>
                <span class="footer__arrow">{% render 'icon', icon: 'chevron-small' %}</span>
              </button>
            {%- endif -%}
          {%- endif -%}

          <div class="footer__group-content">
            {%- if block.type == 'text' -%}
              {%- if block.settings.image_placement == 'above_text' -%}
                {{ rendered_image }}
              {%- endif -%}
              <div class="fs-body-100 footer__text">{{ block.settings.text }}</div>
              {%- if rendered_image and block.settings.image_placement == 'below_text' -%}
                {{ rendered_image }}
              {%- endif -%}

              {%- if block.settings.show_social_icons -%}
                {% render 'social-icons' %}
              {%- endif -%}

              {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                <div class="footer__follow-on-shop">
                  {{ shop | login_button: action: 'follow' }}
                </div>
              {%- endif -%}

            {%- elsif block.type == 'links' -%}
              <div class="footer__links fs-body-100">
                {% if linklists[block.settings.link_list].links.size > 0 %}
                  <ul>
                    {% for link in linklists[block.settings.link_list].links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>

            {%- elsif block.type == 'liquid' -%}
              <div class="footer__liquid fs-body-100">
                {{ block.settings.liquid }}
              </div>

            {%- elsif block.type == 'newsletter' -%}
              <div class="footer__newsletter">
                <div class="ff-heading fs-body-150 footer__text">{{ block.settings.text }}</div>

                {% assign custom_button_label = 'general.newsletter_form.submit' | t %}

                {% assign custom_button_label = 'general.newsletter_form.submit' | t %}

{% render 'newsletter-form',
  base_class: 'footer__newsletter',
  form_id: 'footer-subscribe',
  success_msg: section.settings.newsletter_success,
  custom_button: true,
  custom_button_id: 'Subscribe-footer',
  custom_button_class: 'footer__newsletter-button product-form__cart-submit btn btn--medium btn--primary',
  custom_button_label: custom_button_label,
  button_label: custom_button_label
%}


                {%- if block.settings.show_social_icons -%}
                  {% render 'social-icons' %}
                {%- endif -%}

                {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                  <div class="footer__follow-on-shop">
                    {{ shop | login_button: action: 'follow' }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        {%- if locale_selector or country_selector -%}
          {% render 'cross-border',
            show_locale: locale_selector,
            show_country: country_selector,
            id: 'footer',
            defer_styles: true
          %}
        {% endif %}

       
        <div class="footer__credits fs-body-50">
          <div class="payment-icons__icon", style="text-align:center">
            <img alt="visa" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/visa.sxIq5Dot.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">
            <img alt="master" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/master.CzeoQWmc.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">
            <img alt="american express" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/american_express.C3z4WB9r.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">    
            <img alt="discover" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/discover.C7UbFpNb.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">
            <img alt="diners" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/diners_club.B9hVEmwz.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">
            <img alt="jcb" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/jcb.BgZHqF0u.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">
            <img alt="maestro" src="/cdn/shopifycloud/checkout-web/assets/c1/assets/maestro.ByfUQi1c.svg" role="img" width="38" height="24" class="_1tgdqw61 _1tgdqw60 _1fragemud _1fragemu8 _1fragemun _1tgdqw66">  
            <svg style="transform: scaleY(1)" class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" width="38" height="24" role="img" aria-labelledby="pi-paypal"><title id="pi-paypal">PayPal</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"></path><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"></path><path fill="#003087" d="M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z"></path><path fill="#3086C8" d="M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.1-3.2.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.5-.8z"></path><path fill="#012169" d="M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z"></path></svg>
        </div>
      </div>
      <div class="footer__bottom-right">
        {%- if payment_icons -%}
          {% render 'payment-icons' %}
        {%- endif %}
      </div>
       <div class="footer__credits fs-body-50">
          <p style="text-align:center; font-size:13px; color:#777; direction:rtl;">
            Powered by
            <a href="https://yybranding.co.il" target="_blank" style="color:#555; font-weight:600; text-decoration:none;">
              YY Branding
            </a>
          </p>
        </div>

      
    </div>
  </div>
</div>

<style>
/* === FOOTER refined === */
:root {
  --footer-link-color: #b8bdc2;
  --footer-link-hover: #000;
  --footer-heading-color: #000;
}

/* כותרות */
.footer__heading,
.footer__header .fs-accent {
  color: var(--footer-heading-color) !important;
  font-weight: 400 !important;
  font-family: "IBM Plex Sans Hebrew", sans-serif !important;
  font-size: 14px !important;
  margin: 0 0 12px 0 !important;
}

/* קישורים */
.footer__group a,
.footer__links a {
  color: var(--footer-link-color) !important;
  font-family: "IBM Plex Sans Hebrew", sans-serif !important;
  font-size: 14px !important;
  text-decoration: none !important;
  border-bottom: 1px solid rgba(184, 189, 194, 0.4);
  padding-bottom: 2px;
  transition: color .2s, border-color .2s;
}

.footer__group a:hover,
.footer__links a:hover {
  color: var(--footer-link-hover) !important;
  border-bottom: 1px solid var(--footer-link-hover);
}

/* יישור לימין */
.footer__group,
.footer__header {
  text-align: right;
}

/* טיפוגרפיה */
.footer__newsletter-input,
.footer__newsletter-button {
  font-family: "IBM Plex Sans Hebrew", sans-serif !important;
  font-size: 14px !important;
}

/* ============================
        ניוזלטר RTL – שורה אחת
   ============================ */

html[dir="rtl"] body .footer__newsletter-email {
  display: flex !important;
  align-items: stretch !important;
  gap: 10px !important;
  margin: 0 auto;
  width: 100% !important;
}

/* השדה – 65% */
html[dir="rtl"] body .footer__newsletter-email input[type="email"] {
  flex: 0 0 65% !important;
  max-width: 65% !important;
  min-width: 0 !important;
  border: none;
  border-bottom: 1px solid #cfcfcf;
  border-radius: 0;
  padding: 0.75rem 0;
  background: transparent;
  outline: none;
}

/* הכפתור – 35% */
html[dir="rtl"] body .footer__newsletter-button {
  flex: 0 0 35% !important;
  max-width: 35% !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: auto !important;
  white-space: nowrap !important;
  margin: 0 !important;
}

/* טקסט לבן בכפתור */
html[dir="rtl"] body .footer__newsletter-button,
html[dir="rtl"] body .footer__newsletter-button span {
  color: #fff !important;
}

/* ================
   צ'קבוקס ניוזלטר
   ================ */

html[dir="rtl"] body .footer__newsletter-consent {
  max-width: 480px;
  font-size: 0.75rem;
  text-align: right;
  display: flex;
  align-items: right;
  gap: 0.5rem;
}

html[dir="rtl"] body .footer__newsletter-consent input[type="checkbox"] {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
}

html[dir="rtl"] body .footer__newsletter-consent label {
  cursor: pointer;
}

/* אייקונים הפוכים */
.footer .social-icons .icon svg {
  transform: scaleX(-1) !important;
}


</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "footer__parent",
  "settings": [
    {
      "type": "header",
      "content": "t:shared.settings.localization.locale_selector.header.content",
      "info": "t:shared.settings.localization.locale_selector.header.info"
    },
    {
      "type": "checkbox",
      "id": "enable_locale_selector",
      "label": "t:shared.settings.localization.locale_selector.enable_locale_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:shared.settings.localization.country_selector.header.content",
      "info": "t:shared.settings.localization.country_selector.header.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:shared.settings.localization.country_selector.enable_country_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.payment_types.header.content",
      "info": "t:sections.footer.settings.payment_types.header.info"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.payment_types.show_payment_icons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.additional_content.header.content"
    },
    {
      "type": "richtext",
      "id": "additional_copyright_text",
      "label": "t:sections.footer.settings.additional_content.additional_copyright_text.label"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "range",
          "id": "desktop_width",
          "label": "t:sections.footer.blocks.shared.settings.desktop_width.label",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "desktop_padding",
          "label": "t:sections.footer.blocks.shared.settings.desktop_padding.label",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "%",
          "default": 2
        },
        {
          "type": "checkbox",
          "id": "collapse_on_mobile",
          "label": "t:sections.footer.blocks.shared.settings.collapse_on_mobile.label",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.shared.settings.title.label",
          "default": "t:sections.footer.blocks.shared.settings.title.default_text"
        },
        {
          "type": "checkbox",
          "id": "show_title_on_desktop",
          "label": "t:sections.footer.blocks.shared.settings.show_title_on_desktop.label",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "t:sections.footer.blocks.text.settings.text.default"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.footer.blocks.text.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_max_width",
          "label": "t:sections.footer.blocks.text.settings.image_max_width.label",
          "min": 50,
          "max": 350,
          "step": 10,
          "unit": "px",
          "default": 200
        },
        {
          "type": "select",
          "id": "image_placement",
          "label": "t:sections.footer.blocks.text.settings.image_placement.label",
          "options": [
            { "value": "above_text", "label": "t:sections.footer.blocks.text.settings.image_placement.options.above_text" },
            { "value": "below_text", "label": "t:sections.footer.blocks.text.settings.image_placement.options.below_text" }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_social_icons",
          "label": "t:sections.footer.blocks.shared.settings.social_media.show_social_icons.label",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "enable_follow_on_shop",
          "label": "t:sections.footer.blocks.shared.settings.follow_on_shop.enable_follow_on_shop.label",
          "default": false
        }
      ]
    },

    {
      "type": "links",
      "name": "t:sections.footer.blocks.links.name",
      "settings": [
        {
          "type": "range",
          "id": "desktop_width",
          "label": "t:sections.footer.blocks.shared.settings.desktop_width.label",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 20
        },
        {
          "type": "range",
          "id": "desktop_padding",
          "label": "t:sections.footer.blocks.shared.settings.desktop_padding.label",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "%",
          "default": 4
        },
        {
          "type": "checkbox",
          "id": "collapse_on_mobile",
          "label": "t:sections.footer.blocks.shared.settings.collapse_on_mobile.label",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.shared.settings.title.label",
          "default": "t:sections.footer.blocks.shared.settings.title.default_links"
        },
        {
          "type": "checkbox",
          "id": "show_title_on_desktop",
          "label": "t:sections.footer.blocks.shared.settings.show_title_on_desktop.label",
          "default": true
        },
        {
          "type": "link_list",
          "id": "link_list",
          "label": "t:sections.footer.blocks.links.settings.link_list.label",
          "default": "footer"
        }
      ]
    },

    {
      "type": "liquid",
      "name": "t:sections.footer.blocks.liquid.name",
      "settings": [
        {
          "type": "range",
          "id": "desktop_width",
          "label": "t:sections.footer.blocks.shared.settings.desktop_width.label",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "desktop_padding",
          "label": "t:sections.footer.blocks.shared.settings.desktop_padding.label",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "%",
          "default": 2
        },
        {
          "type": "liquid",
          "id": "liquid",
          "label": "t:sections.footer.blocks.liquid.settings.liquid.label"
        }
      ]
    },

    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "settings": [
        {
          "type": "range",
          "id": "desktop_width",
          "label": "t:sections.footer.blocks.shared.settings.desktop_width.label",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "desktop_padding",
          "label": "t:sections.footer.blocks.shared.settings.desktop_padding.label",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "%",
          "default": 2
        },
        {
          "type": "checkbox",
          "id": "collapse_on_mobile",
          "label": "t:sections.footer.blocks.shared.settings.collapse_on_mobile.label",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.shared.settings.title.label",
          "default": "t:sections.footer.blocks.shared.settings.title.default_newsletter"
        },
        {
          "type": "checkbox",
          "id": "show_title_on_desktop",
          "label": "t:sections.footer.blocks.shared.settings.show_title_on_desktop.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_collect_customer_name",
          "label": "t:shared.options.enable_collect_customer_name.label",
          "default": false
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.newsletter.settings.text.label",
          "default": "t:sections.footer.blocks.newsletter.settings.text.default"
        },
        {
          "type": "checkbox",
          "id": "show_social_icons",
          "label": "t:sections.footer.blocks.shared.settings.social_media.show_social_icons.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_follow_on_shop",
          "label": "t:sections.footer.blocks.shared.settings.follow_on_shop.enable_follow_on_shop.label",
          "default": true
        }
      ]
    },

    {
      "type": "spacer",
      "name": "t:sections.footer.blocks.spacer.name",
      "settings": [
        {
          "type": "range",
          "id": "desktop_width",
          "label": "t:sections.footer.blocks.shared.settings.desktop_width.label",
          "min": 5,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 5
        }
      ]
    }
  ],

  "default": {
    "blocks": [
      { "type": "text" },
      { "type": "links" },
      { "type": "spacer" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
