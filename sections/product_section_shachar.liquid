<div class="product__callouts-section section-{{ section.id }}">
  <div class="product__callouts-item fs-body-75">
    
    {%- if section.settings.custom_icon_image != blank -%}
      {%-
        render 'image' with
        wrapper_class: "product__callouts-item-icon",
        image: section.settings.custom_icon_image,
        sizes: "32px",
      -%}
    {%- elsif section.settings.icon != 'none' -%}
      {% render 'icon-editorial' with class: "product__callouts-item-icon", icon: section.settings.icon %}
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="product__callouts-item-text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
{
  "name": "Product Callout",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Callout Text",
      "default": "<p>Add your callout text here</p>"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "truck", "label": "Shipping Truck" },
        { "value": "heart", "label": "Heart" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Custom Icon Image",
      "info": "Overrides the icon selection above"
    }
  ],
  "presets": [
    {
      "name": "Product Callout"
    }
  ]
}
{% endschema %}
