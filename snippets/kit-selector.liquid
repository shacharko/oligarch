{%- comment -%}
KIT SELECTOR — brand_info by brand_name (== product.vendor), 2ml only.
Single searchable multi-select picker: customer checks {{ required }} samples from one list.
Cart contract (load-bearing, fulfillment reads it): ONE line item (the kit variant) with
line-item properties "דוגמית 1".."דוגמית N" = chosen sample titles in pick order.
{%- endcomment -%}

{%- assign rc = required | default: 5 -%}

{%- assign vendor_norm = product.vendor | default: '' | strip | downcase -%}
{%- assign brand_meta = nil -%}
{%- if shop.metaobjects and shop.metaobjects['brand_info'] and shop.metaobjects['brand_info'].values -%}
  {%- for entry in shop.metaobjects['brand_info'].values -%}
    {%- assign entry_name = entry.brand_name.value | default: '' | strip | downcase -%}
    {%- if entry_name == vendor_norm -%}
      {%- assign brand_meta = entry -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign brand_collection = nil -%}
{%- if brand_meta and brand_meta.brand_collection and brand_meta.brand_collection.value -%}
  {%- assign brand_collection = brand_meta.brand_collection.value -%}
{%- endif -%}

{%- capture kit_data_all -%}
[
{%- assign first_product = true -%}
{%- if brand_collection and brand_collection.products_count > 0 -%}
  {%- for p in brand_collection.products -%}
    {%- assign pass_flag = false -%}
    {%- if p.metafields.custom.is_sample_set and p.metafields.custom.is_sample_set.value == true -%}
      {%- assign pass_flag = true -%}
    {%- endif -%}
    {%- if pass_flag -%}
      {%- assign variants_2ml_count = 0 -%}
      {%- for v in p.variants -%}
        {%- assign is_2ml = false -%}
        {%- for opt in v.options -%}
          {%- assign od = opt | downcase | strip | replace: 'מ״ל','ml' | replace: 'מ"ל','ml' | replace: 'מל','ml' | replace: ' ', '' -%}
          {%- if od contains '2ml' -%}{%- assign is_2ml = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if is_2ml -%}{%- assign variants_2ml_count = variants_2ml_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      {%- if variants_2ml_count > 0 -%}
        {%- assign featured = p.featured_media | default: p.featured_image -%}
        {%- assign image_url = featured | img_url: '240x240', scale: 2 | prepend: 'https:' -%}
        {%- assign p_max_price = 0 -%}
        {%- for v in p.variants -%}
          {%- if v.price > p_max_price -%}{%- assign p_max_price = v.price -%}{%- endif -%}
        {%- endfor -%}
        {%- unless first_product -%},{%- endunless -%}
        {
          "product_id": {{ p.id }},
          "product_title": {{ p.title | json }},
          "vendor": {{ p.vendor | json }},
          "image": {{ image_url | json }},
          "max_variant_price": {{ p_max_price }},
          "variants": [
            {%- assign vfirst = true -%}
            {%- for v in p.variants -%}
              {%- assign is_2ml = false -%}
              {%- for opt in v.options -%}
                {%- assign od = opt | downcase | strip | replace: 'מ״ל','ml' | replace: 'מ"ל','ml' | replace: 'מל','ml' | replace: ' ', '' -%}
                {%- if od contains '2ml' -%}{%- assign is_2ml = true -%}{%- endif -%}
              {%- endfor -%}
              {%- if is_2ml -%}
                {%- unless vfirst -%},{%- endunless -%}
                {
                  "id": {{ v.id }},
                  "name": {{ p.title | json }},
                  "available": {{ v.available | json }},
                  "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
                  "price": {{ v.price }},
                  "values": {{ v.options | json }}
                }
                {%- assign vfirst = false -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
        {%- assign first_product = false -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
]
{%- endcapture -%}

<div id="kit-selector" class="product-form-block" data-required="{{ rc }}">
  <div class="kit-picker">
    <div class="kit-picker__header">
      <span class="kit-picker__title">{{ 'kit.choose_title' | t: count: rc }}</span>
      <span class="kit-picker__progress">
        <span class="kit-picker__count" data-kit-count></span>
        <span class="kit-picker__dots" aria-hidden="true">
          {%- for i in (1..rc) -%}
            <span class="kit-dot" data-kit-dot>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 7"/></svg>
            </span>
          {%- endfor -%}
        </span>
      </span>
    </div>

    <button type="button" class="kit-picker__toggle" data-kit-toggle aria-expanded="false" aria-controls="kit-picker-panel">
      <span class="kit-picker__toggle-label">{{ 'kit.select_placeholder' | t }}</span>
      <svg class="kit-picker__chevron" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7l5 6 5-6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>

    <div class="kit-picker__panel" id="kit-picker-panel" data-kit-panel hidden>
      <label class="kit-picker__search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        <input type="search" data-kit-search placeholder="{{ 'kit.search_placeholder' | t }}" autocomplete="off">
      </label>
      <ul class="kit-picker__list" data-kit-list role="listbox" aria-multiselectable="true"></ul>
    </div>
  </div>

  <style>
    .kit-picker{border:1.5px solid #e0d0b8;border-radius:12px;background:#f7f2eb;padding:12px;direction:ltr}
    .kit-picker__header{display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap;margin-bottom:10px}
    .kit-picker__title{font-weight:700;font-size:15px;color:#1c1008}
    .kit-picker__progress{display:flex;align-items:center;gap:8px}
    .kit-picker__count{font-size:12px;color:#6b6b6b;white-space:nowrap}
    .kit-picker__dots{display:inline-flex;gap:4px}
    .kit-dot{width:15px;height:15px;border-radius:50%;border:1.5px solid #c9c9c9;display:inline-flex;align-items:center;justify-content:center;color:transparent;flex-shrink:0;transition:background .15s,border-color .15s}
    .kit-dot svg{width:9px;height:9px}
    .kit-dot--filled{background:#B8860B;border-color:#B8860B;color:#fff}
    .kit-picker__toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:10px 12px;border:1px solid #e0d0b8;border-radius:8px;background:#fff;font-size:13px;color:#1c1008;cursor:pointer;text-align:start}
    .kit-picker__chevron{transition:transform .25s ease;flex-shrink:0}
    .kit-picker__toggle[aria-expanded="true"] .kit-picker__chevron{transform:rotate(180deg)}
    .kit-picker__panel{border:1px solid #e0d0b8;border-radius:8px;margin-top:6px;overflow:hidden;background:#fff;transform-origin:top;transition-property:opacity,transform,display;transition-duration:.25s;transition-timing-function:ease;transition-behavior:allow-discrete}
    .kit-picker__panel[hidden]{display:none;opacity:0;transform:translateY(-8px) scaleY(.97)}
    @starting-style{.kit-picker__panel:not([hidden]){opacity:0;transform:translateY(-8px) scaleY(.97)}}
    @media (prefers-reduced-motion:reduce){.kit-picker__panel{transition:none}}
    .kit-picker__search{display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid #ececec;color:#8a8a8a}
    .kit-picker__search input{flex:1 1 auto;min-width:0;border:0;outline:0;background:transparent;font-size:13px;color:#1c1008;padding:0}
    .kit-picker__search input::placeholder{color:#a5a5a5}
    .kit-picker__list{list-style:none;margin:0;padding:4px 0;max-height:330px;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch}
    .kit-option{display:flex;align-items:center;gap:10px;padding:8px 12px;cursor:pointer}
    .kit-option:hover{background:#f7f7f7}
    .kit-option[aria-disabled="true"]{opacity:.45;cursor:not-allowed}
    .kit-option__img{width:38px;height:38px;object-fit:contain;flex-shrink:0}
    .kit-option__details{display:flex;flex-direction:column;flex:1 1 auto;min-width:0;text-align:start}
    .kit-option__title{font-size:13px;font-weight:600;color:#1c1008;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .kit-option__vendor{font-size:11px;color:#8a8a8a;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .kit-option__note{font-size:11px;color:#a5a5a5;white-space:nowrap;flex-shrink:0}
    .kit-option__note--oos{color:#d32f2f;font-weight:600}
    .kit-option__check{width:17px;height:17px;border:1.5px solid #c9c9c9;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;color:transparent;flex-shrink:0;transition:background .15s,border-color .15s}
    .kit-option__check svg{width:11px;height:11px}
    .kit-option--selected .kit-option__check{background:#B8860B;border-color:#B8860B;color:#fff}
    .kit-option--empty{justify-content:center;color:#8a8a8a;font-size:13px;cursor:default}
    .kit-option--empty:hover{background:transparent}
    [dir="rtl"] .kit-picker{direction:rtl}
  </style>
</div>

<script type="application/json" id="kit-data-json">{{ kit_data_all | strip }}</script>
<script type="application/json" id="variants-map-json">{}</script>
<script>
  window.KIT = {
    alreadySelected: {{ 'kit.already_selected' | t | json }},
    outOfStock: {{ 'kit.out_of_stock' | t | json }},
    remaining: {{ 'kit.remaining' | t | json }},
    selectedLabel: {{ 'kit.selected_label' | t | json }},
    noSamples: {{ 'kit.no_samples' | t | json }}
  };
</script>
<script>
(function(){
function kitInit(){
  var DATA_ALL = JSON.parse(document.getElementById('kit-data-json').textContent || '[]');
  var REQUIRED = Number({{ rc }}) || 5;
  var root = document.getElementById('kit-selector');
  var toggle = root.querySelector('[data-kit-toggle]');
  var panel = root.querySelector('[data-kit-panel]');
  var listEl = root.querySelector('[data-kit-list]');
  var searchEl = root.querySelector('[data-kit-search]');
  var countEl = root.querySelector('[data-kit-count]');
  var dots = root.querySelectorAll('[data-kit-dot]');
  var addBtn = document.getElementById('kit-add-to-cart-button');
  var form = document.querySelector('form[action="/cart/add"]') || document.querySelector('product-form form');

  var KIT_T = window.KIT || {};
  var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>';

  var selection = []; // variant ids (strings) in pick order — drives the "דוגמית N" cart properties
  var query = '';

  function esc(s){
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function allOptions(){
    var out=[];
    DATA_ALL.forEach(function(p){
      (p.variants||[]).forEach(function(v){
        out.push({
          product_title:v.name||p.product_title,
          vendor:p.vendor||'',
          variant_id:String(v.id),
          available:!!v.available,
          image:p.image,
          inventory_quantity:v.inventory_quantity,
          price:v.price||0,
          max_price:p.max_variant_price||0
        });
      });
    });
    return out;
  }

  function isOutOfStock(item){
    var total=Number(item.inventory_quantity);
    if(isNaN(total)||total<0) total=9999;
    return !item.available || total<=0;
  }

  function fillTpl(tpl,vars){
    return String(tpl||'').replace(/\{\{\s*(\w+)\s*\}\}/g,function(m,k){
      return (k in vars)?vars[k]:m;
    }).replace(/%\{(\w+)\}/g,function(m,k){
      return (k in vars)?vars[k]:m;
    });
  }

  function updateHeader(){
    var tpl=KIT_T.selectedLabel||'Selected: {{ count }}/{{ total }}';
    countEl.textContent=fillTpl(tpl,{count:selection.length,total:REQUIRED});
    dots.forEach(function(dot,i){
      dot.classList.toggle('kit-dot--filled',i<selection.length);
    });
  }

  function refreshATC(){
    if(!addBtn) return;
    var done=selection.length>=REQUIRED;
    addBtn.disabled=!done;
    addBtn.classList.toggle('disabled',!done);
  }

  function renderList(){
    var items=allOptions();
    var q=query.trim().toLowerCase();
    if(q){
      items=items.filter(function(i){
        return (i.product_title+' '+i.vendor).toLowerCase().indexOf(q)!==-1;
      });
    }

    var scrollPos=listEl.scrollTop;
    listEl.innerHTML='';

    if(!items.length){
      var li=document.createElement('li');
      li.className='kit-option kit-option--empty';
      li.textContent=KIT_T.noSamples||'No samples available';
      listEl.appendChild(li);
      return;
    }

    var full=selection.length>=REQUIRED;

    items.forEach(function(item){
      var selected=selection.indexOf(item.variant_id)!==-1;
      var oos=isOutOfStock(item);
      var disabled=oos||(full&&!selected);

      var li=document.createElement('li');
      li.className='kit-option'+(selected?' kit-option--selected':'');
      li.setAttribute('role','option');
      li.setAttribute('aria-selected',String(selected));
      li.setAttribute('data-variant-id',item.variant_id);
      li.setAttribute('data-title',item.product_title);
      if(disabled) li.setAttribute('aria-disabled','true');

      var total=Number(item.inventory_quantity);
      if(isNaN(total)||total<0) total=9999;
      var note='';
      if(oos){
        note='<span class="kit-option__note kit-option__note--oos">'+esc(KIT_T.outOfStock||'Out of stock')+'</span>';
      } else if(total!==9999){
        note='<span class="kit-option__note">'+esc(fillTpl(KIT_T.remaining||'({{ count }} left)',{count:total}))+'</span>';
      }

      var img=item.image?'<img class="kit-option__img" src="'+esc(item.image)+'" alt="" loading="lazy">':'';
      var vendor=item.vendor?'<span class="kit-option__vendor">'+esc(item.vendor)+'</span>':'';

      li.innerHTML=img
        +'<div class="kit-option__details">'
        +'<span class="kit-option__title">'+esc(item.product_title)+'</span>'
        +vendor
        +'</div>'
        +note
        +'<span class="kit-option__check">'+CHECK_SVG+'</span>';
      listEl.appendChild(li);
    });

    listEl.scrollTop=scrollPos;
  }

  // מודיע לבלוקים אחרים על שינוי בחירה
  function broadcastSelection(){
    var list=allOptions();
    var selected=[];
    selection.forEach(function(vid,idx){
      var item=list.find(function(i){return i.variant_id===vid;});
      if(item) selected.push({
        slot:idx+1,
        variant_id:item.variant_id,
        title:item.product_title,
        image:item.image,
        price:item.price,
        max_price:item.max_price
      });
    });
    var detail={selected:selected,required:REQUIRED,options:list};
    window.__kitSelection=detail;
    document.dispatchEvent(new CustomEvent('kit:selection-change',{detail:detail}));
  }

  function refresh(){
    renderList();
    updateHeader();
    refreshATC();
    broadcastSelection();
  }

  listEl.addEventListener('click',function(e){
    var li=e.target.closest('.kit-option');
    if(!li||li.classList.contains('kit-option--empty')||li.getAttribute('aria-disabled')==='true') return;
    var vid=li.getAttribute('data-variant-id');
    var idx=selection.indexOf(vid);
    if(idx!==-1){ selection.splice(idx,1); }
    else if(selection.length<REQUIRED){ selection.push(vid); }
    refresh();
  });

  searchEl.addEventListener('input',function(){
    query=searchEl.value||'';
    renderList();
  });

  toggle.addEventListener('click',function(){
    var expanded=toggle.getAttribute('aria-expanded')==='true';
    toggle.setAttribute('aria-expanded',String(!expanded));
    panel.hidden=expanded;
  });

  document.addEventListener('click',function(ev){
    // list rows are re-rendered on pick, so a clicked row is already detached by the
    // time the event bubbles here — a disconnected target is never an outside click
    if(!ev.target.isConnected) return;
    if(!root.contains(ev.target)&&toggle.getAttribute('aria-expanded')==='true'){
      toggle.setAttribute('aria-expanded','false');
      panel.hidden=true;
    }
  });

  document.addEventListener('keydown',function(ev){
    if(ev.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){
      toggle.setAttribute('aria-expanded','false');
      panel.hidden=true;
    }
  });

  // הוספה לעגלה — פריט אחד של ערכת הקיט + properties "דוגמית 1..N" (חוזה מול המחסן)
  if(addBtn){
    addBtn.addEventListener('click',function(ev){
      ev.preventDefault();
      if(selection.length<REQUIRED){ refreshATC(); return; }

      var formEl=form;
      var mainVariantInput=formEl?formEl.querySelector('[name="id"]'):null;
      var mainVariantId=mainVariantInput?mainVariantInput.value:null;

      var list=allOptions();
      var props={};
      selection.forEach(function(vid,idx){
        var item=list.find(function(i){return i.variant_id===vid;});
        var title=item?item.product_title:'';
        props['דוגמית '+(idx+1)]=(title||'').split(' (')[0];
      });
      var qtyInput=formEl?formEl.querySelector('[name="quantity"]'):null;
      var qty=qtyInput?(parseInt(qtyInput.value,10)||1):1;

      var payload={items:[{id:Number(mainVariantId),quantity:qty,properties:props}]};

      fetch('/cart/add.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify(payload)
      }).then(function(r){ if(!r.ok) throw new Error('AJAX fail'); return r.json(); })
        .then(function(){
          if(location.pathname.indexOf('/cart')===-1){ location.href='/cart'; } else { location.reload(); }
        })
        .catch(function(e){ console.error('Submission failed:', e); });
    });
  }

  refresh();
}

// the picker renders above the product form, so wait for the full DOM before
// looking up #kit-add-to-cart-button / the cart form
if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',kitInit);
}else{
  kitInit();
}
})();
</script>
