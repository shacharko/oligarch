{%- comment -%}
  Pass in:
  - blocks: section's blocks
  - prod: product object
  - featured_media
  - aspect_ratio
  - current_variant
  - is_quick: boolean to indicate if we are rendering quick product or not. Some sections omitted if true
  - is_featured: boolean to indicate if we are rendering featured product or not.
  - column (optional): "left" or "right" to filter by "column_placement"
  - price_content_type: "price" or "custom" or "hide" after checking both $0 and sold out pricing display settings
  - custom_price_content: the translation to populate price if sold out or free, depending on logic checks and settings
  - custom_color_key_map: { Object } An array of custom swatch color keys (names).
  - custom_color_value_map: { Object } An array of custom swatch color values (HEX values).
{%- endcomment -%}
{%- capture product_url -%}{{ shop.url | append: prod.url }}{%- endcapture -%}

{%- for block in blocks -%}
  {% assign renderBlock = false %}
  {% if column == block.settings.column_placement
    or column == 'right'
    and block.settings.column_placement == blank
    or column == blank
  %}
    {% assign renderBlock = true %}
  {% endif %}

  {% if renderBlock == true %}
    {%- case block.type -%}
      {%- when '@app' -%}
        {% render block %}

      {%- when 'product_header' -%}
        {% if is_quick %}<div class="quick-product--header-block-wrap">{% endif %}
        {%-
          render 'product-block-header' with
          product: prod,
          block: block,
          block_settings: block.settings,
          current_variant: current_variant,
          is_quick: is_quick,
          is_featured: is_featured,
          featured_media: featured_media,
          price_content_type: price_content_type,
          custom_price_content: custom_price_content
        -%}
        {% if is_quick %}</div>{% endif %}
      {%- when 'spacer' -%}
        <div
          class="product-block-spacer product__block product__block--medium"
          style="height: {{ block.settings.space }}px"
          {{ block.shopify_attributes }}
        ></div>

      {%- when 'variant_picker' -%}
        {%- if prod != blank -%}
          {%- render 'product-block-variant-picker',
            product: prod,
            block: block,
            block_settings: block.settings,
            current_variant: current_variant,
            use_variant_images: settings.use_variant_image_swatches,
            show_siblings: settings.enable_product_sibling_swatches,
            custom_color_key_map: custom_color_key_map,
            custom_color_value_map: custom_color_value_map
          -%}
        {%- endif -%}

      {%- when 'quantity_selector' -%}
        {%- if prod != blank -%}
          {%-
            render 'product-block-quantity-selector' with
            product: prod,
            block: block,
            block_settings: block.settings,
          -%}
        {%- endif -%}

      {%- when 'custom_option' -%}
        {%- render 'product-block-custom-option', block: block, field_type: block.settings.field_type -%}

      {%- when 'buy_buttons' -%}
        {%- if prod != blank -%}
          {%-
            render 'product-block-buy-buttons' with
            prod: prod,
            block: block,
            blocks: blocks,
            block_settings: block.settings,
            current_variant: current_variant,
            featured_media: featured_media,
            aspect_ratio: aspect_ratio,
            price_content_type: price_content_type,
            custom_price_content: custom_price_content
          -%}
        {%- else -%}
          <div class="product-form">
            <div class="product-form__controls-group product-form__controls-group--submit">
              <button
                type="button"
                aria-disabled="true"
                disabled
                class="product-form__cart-submit btn btn--medium btn--full"
              >
                <span>
                  {{ 'products.product.add_to_cart' | t }}
                </span>
              </button>
            </div>
          </div>
        {%- endif -%}

      {%- when 'description' -%}
        {%-
          render 'product-block-description' with
          product: prod,
          block: block,
          block_settings: block.settings,
        -%}

      {%- when 'product_callouts' -%}
        {%- render 'product-block-callouts' with block: block, block_settings: block.settings %}

      {%- when 'product_callouts_mini' -%}
        {%- render 'product-block-callouts-mini' with block: block, block_settings: block.settings %}

      {%- when 'text' -%}
        {%
          render 'product-block-text' with
          content: block.settings.text,
          block_settings: block.settings,
          block: block,
        %}

      {%- when 'share' -%}
        {%- if prod != blank -%}
          {%- liquid
            assign share_alignment = 'left-below'

            if is_quick or is_featured
              assign share_alignment = 'left-above'
            endif
          -%}

          <div class="product-block-social-share product__block product__block--medium" {{ block.shopify_attributes }}>
            {% render 'social-share',
              url: product_url,
              title: product.title,
              image: product.featured_image,
              alignment: share_alignment
            %}
          </div>
        {%- endif -%}

      {%- when 'inventory-counter' -%}
        {%- if prod != blank -%}
          {%-
            render 'inventory-counter' with
            product: prod,
            block: block,
            block_settings: block.settings,
            current_variant: current_variant,
          -%}
        {%- endif -%}

      {%- when 'accordion' -%}
        {%- render 'product-block-accordion',
          block: block,
          block_settings: block.settings,
          heading: block.settings.heading,
          content: block.settings.content
        -%}

      {%- when 'custom_liquid' -%}
        {%- unless block.settings.custom_liquid == blank -%}
          <div class="product-block-custom-liquid product__block product__block--medium" {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </div>
        {%- endunless -%}

      {%- when 'information_popup' -%}
        {%- assign popup_modal_page = pages[block.settings.popup_page] -%}

        {%- if block.settings.popup_text != blank and popup_modal_page.content != blank -%}
          {%
            render 'product-block-information-popup' with
            block: block,
            popup_page_target: block.settings.popup_page,
            popup_page: popup_modal_page,
            icon: block.settings.popup_icon,
            custom_icon_image: block.settings.custom_icon_image,
            text: block.settings.popup_text
          %}
        {%- endif -%}
      {%- when 'featured_products' -%}
        {%- render 'product-block-featured-products', block: block, product: prod -%}

      {%- when 'image' -%}
        <div
          class="
            product-block-image
            product__block
            product__block--medium
          "
        >
          {%-
            render 'image-block' with
            shopify_attributes: block.shopify_attributes,
            wrapper_class: 'product-block-image__text-container-image  section-blocks__image',
            image: block.settings.image,
            width: block.settings.image_size,
            mobile_width: block.settings.image_size_mobile,
            break_to_mobile_at: '720',
            align: block.settings.alignment,
          -%}
        </div>

      {%- when 'secure_payment' -%}
        {%- render 'product-block-secure-payment', product: prod, block: block, block_settings: block.settings -%}

      {%- when 'discount_badge' -%}
        {%- if prod != blank -%}
          {%- render 'product-block-discount-badge', prod: prod, block: block -%}
        {%- endif -%}

      {%- when 'whats-inside-box' -%}
        {%- render 'product-block-whats-inside', prod: prod, block: block -%}

      {%- when 'mix_match_banner' -%}
        {%- if prod != blank -%}
          {%- liquid
            assign mmb_show_for   = block.settings.show_for_sizes | default: '2ml,5ml,10ml'
            assign mmb_show_sizes = mmb_show_for | split: ','
            assign mmb_show_ids   = ''
          -%}
          {%- for mmb_v in prod.variants -%}
            {%- assign mmb_title_low = mmb_v.title | downcase | strip | remove: ' ' -%}
            {%- assign mmb_matches  = false -%}
            {%- for mmb_size in mmb_show_sizes -%}
              {%- assign mmb_size_clean = mmb_size | strip | downcase | remove: ' ' -%}
              {%- if mmb_title_low == mmb_size_clean -%}
                {%- assign mmb_matches = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if mmb_matches -%}
              {%- unless mmb_show_ids == '' -%}{%- assign mmb_show_ids = mmb_show_ids | append: ',' -%}{%- endunless -%}
              {%- assign mmb_show_ids = mmb_show_ids | append: mmb_v.id -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign mmb_l1_before = block.settings.line_1_before   | default: 'קנו 5 דוגמיות או יותר' -%}
          {%- assign mmb_l1_hl     = block.settings.line_1_highlight | default: 'באותו גודל' -%}
          {%- assign mmb_l2_before = block.settings.line_2_before   | default: 'וקבלו' -%}
          {%- assign mmb_l2_hl     = block.settings.line_2_highlight | default: 'מארז יוקרתי במתנה' -%}

          <div
            class="mmb-block product__block product__block--medium"
            data-mmb-show-ids="{{ mmb_show_ids }}"
            style="display:none"
            {{ block.shopify_attributes }}
          >
            <div class="mmb-inner">
              <div class="mmb-icon-wrap">
                <svg class="mmb-gift-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="4" y="13" width="24" height="16" rx="2" stroke="#c8860a" stroke-width="1.8" fill="none"/>
                  <rect x="2" y="9" width="28" height="5" rx="1.5" stroke="#c8860a" stroke-width="1.8" fill="none"/>
                  <line x1="16" y1="9" x2="16" y2="29" stroke="#c8860a" stroke-width="1.8"/>
                  <path d="M16 9 C16 9 12 7 11 4.5 C10.2 2.6 11.5 1 13 1.5 C14.5 2 15 5 16 9Z" stroke="#c8860a" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
                  <path d="M16 9 C16 9 20 7 21 4.5 C21.8 2.6 20.5 1 19 1.5 C17.5 2 17 5 16 9Z" stroke="#c8860a" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="mmb-text-wrap">
                <svg class="mmb-sparkle mmb-sparkle--left" viewBox="0 0 20 20" fill="#c8860a" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M10 0 L11.5 8.5 L20 10 L11.5 11.5 L10 20 L8.5 11.5 L0 10 L8.5 8.5 Z"/>
                </svg>
                <p class="mmb-text" dir="rtl">
                  {{ mmb_l1_before }} <span class="mmb-hl">{{ mmb_l1_hl }}</span><br>
                  {{ mmb_l2_before }} <span class="mmb-hl">{{ mmb_l2_hl }}</span>
                </p>
                <svg class="mmb-sparkle mmb-sparkle--right" viewBox="0 0 20 20" fill="#c8860a" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M10 0 L11.5 8.5 L20 10 L11.5 11.5 L10 20 L8.5 11.5 L0 10 L8.5 8.5 Z"/>
                </svg>
                <svg class="mmb-sparkle mmb-sparkle--right-small" viewBox="0 0 20 20" fill="#c8860a" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M10 0 L11.5 8.5 L20 10 L11.5 11.5 L10 20 L8.5 11.5 L0 10 L8.5 8.5 Z"/>
                </svg>
              </div>
            </div>
          </div>
          <style>
            .mmb-block { margin: 0; }
            .mmb-inner {
              display: flex;
              align-items: center;
              gap: 14px;
              padding: 14px 16px;
              background: #fdf8f2;
              border: 1.5px solid #e8d9c4;
              border-radius: 16px;
            }
            .mmb-icon-wrap {
              flex-shrink: 0;
              width: 50px;
              height: 50px;
              border-radius: 50%;
              background: #fff;
              border: 1.5px solid #e8d9c4;
              display: flex;
              align-items: center;
              justify-content: center;
            }
            .mmb-gift-icon { width: 28px; height: 28px; }
            .mmb-text-wrap {
              flex: 1;
              display: flex;
              align-items: center;
              gap: 6px;
              min-width: 0;
            }
            .mmb-text {
              flex: 1;
              margin: 0;
              font-size: 15px;
              font-weight: 700;
              line-height: 1.5;
              color: #1c1008;
              text-align: center;
            }
            .mmb-hl {
              color: #c8860a;
              font-weight: 700;
              white-space: nowrap;
            }
            .mmb-sparkle { flex-shrink: 0; }
            .mmb-sparkle--left  { width: 16px; height: 16px; }
            .mmb-sparkle--right { width: 16px; height: 16px; }
            .mmb-sparkle--right-small {
              width: 10px;
              height: 10px;
              margin-left: -4px;
              align-self: flex-end;
              margin-bottom: 4px;
            }
            @media (max-width: 480px) {
              .mmb-inner { padding: 12px; gap: 10px; }
              .mmb-icon-wrap { width: 42px; height: 42px; }
              .mmb-gift-icon { width: 22px; height: 22px; }
              .mmb-text { font-size: 11px; }
              .mmb-sparkle--left, .mmb-sparkle--right { width: 13px; height: 13px; }
              .mmb-sparkle--right-small { width: 8px; height: 8px; }
            }
          </style>
          <script>
            (function () {
              function mmbInit(block) {
                var showIds = (block.getAttribute('data-mmb-show-ids') || '').split(',').filter(Boolean);
                function getForm() {
                  return block.closest('form')
                      || document.querySelector('form[action="/cart/add"]')
                      || document.querySelector('form[action*="/cart/add"]');
                }
                function getVid() {
                  var form = getForm();
                  var scope = form || document;
                  var el = scope.querySelector('[data-variant-select]')
                          || scope.querySelector('select[name="id"]')
                          || scope.querySelector('input[name="id"]:checked')
                          || scope.querySelector('input[name="id"]');
                  return el ? el.value : null;
                }
                function update() {
                  var vid = getVid();
                  block.style.display = (vid && showIds.indexOf(vid) !== -1) ? 'block' : 'none';
                }
                update();
                var _form = getForm();
                if (_form) _form.addEventListener('change', update);
                var _varSel = (_form || document).querySelector('[data-variant-select]');
                if (_varSel) _varSel.addEventListener('change', update);
                document.addEventListener('product:variant-change', update);
              }
              function ready(fn) {
                if (document.readyState !== 'loading') { fn(); }
                else { document.addEventListener('DOMContentLoaded', fn); }
              }
              ready(function () { document.querySelectorAll('.mmb-block').forEach(mmbInit); });
            })();
          </script>
        {%- endif -%}

      {%- when 'authenticity_badge' -%}
        {%- if prod != blank -%}
          {%- liquid
            assign ab_show_for   = block.settings.show_for_sizes | default: '2ml,5ml,10ml'
            assign ab_show_sizes = ab_show_for | split: ','
            assign ab_show_ids   = ''
          -%}
          {%- for ab_v in prod.variants -%}
            {%- assign ab_title_low = ab_v.title | downcase | strip | remove: ' ' -%}
            {%- assign ab_matches  = false -%}
            {%- for ab_size in ab_show_sizes -%}
              {%- assign ab_size_clean = ab_size | strip | downcase | remove: ' ' -%}
              {%- if ab_title_low == ab_size_clean -%}
                {%- assign ab_matches = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if ab_matches -%}
              {%- unless ab_show_ids == '' -%}{%- assign ab_show_ids = ab_show_ids | append: ',' -%}{%- endunless -%}
              {%- assign ab_show_ids = ab_show_ids | append: ab_v.id -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign ab_text  = block.settings.badge_text  | default: '100% מקורי – נמזג ידנית ישירות מהבקבוק המקורי' -%}
          {%- assign ab_color = block.settings.badge_color | default: '#c8860a' -%}

          <div
            class="ab-block product__block"
            data-ab-show-ids="{{ ab_show_ids }}"
            style="display:none"
            {{ block.shopify_attributes }}
          >
            <div class="ab-inner" style="--ab-color: {{ ab_color }};" dir="rtl">
              <svg class="ab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2L4 5.5V11C4 15.418 7.582 19.527 12 21C16.418 19.527 20 15.418 20 11V5.5L12 2Z" stroke="var(--ab-color)" stroke-width="1.8" stroke-linejoin="round" fill="none"/>
                <polyline points="8.5 12 11 14.5 15.5 9.5" stroke="var(--ab-color)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="ab-text">{{ ab_text }}</span>
            </div>
          </div>
          <style>
            .ab-block { margin: 0; }
            .ab-inner { display: flex; align-items: center; gap: 7px; }
            .ab-icon { flex-shrink: 0; width: 18px; height: 18px; }
            .ab-text { font-size: 13px; font-weight: 500; color: var(--ab-color); line-height: 1.3; }
          </style>
          <script>
            (function () {
              function abInit(block) {
                var showIds = (block.getAttribute('data-ab-show-ids') || '').split(',').filter(Boolean);
                function getForm() {
                  return block.closest('form')
                      || document.querySelector('form[action="/cart/add"]')
                      || document.querySelector('form[action*="/cart/add"]');
                }
                function getVid() {
                  var form = getForm();
                  var scope = form || document;
                  var el = scope.querySelector('[data-variant-select]')
                          || scope.querySelector('select[name="id"]')
                          || scope.querySelector('input[name="id"]:checked')
                          || scope.querySelector('input[name="id"]');
                  return el ? el.value : null;
                }
                function update() {
                  var vid = getVid();
                  block.style.display = (vid && showIds.indexOf(vid) !== -1) ? 'block' : 'none';
                }
                update();
                var _form = getForm();
                if (_form) _form.addEventListener('change', update);
                var _varSel = (_form || document).querySelector('[data-variant-select]');
                if (_varSel) _varSel.addEventListener('change', update);
                document.addEventListener('product:variant-change', update);
              }
              function ready(fn) {
                if (document.readyState !== 'loading') { fn(); }
                else { document.addEventListener('DOMContentLoaded', fn); }
              }
              ready(function () { document.querySelectorAll('.ab-block').forEach(abInit); });
            })();
          </script>
        {%- endif -%}

      {%- when 'best_value' -%}
        {%- if prod != blank -%}
          {%- liquid
            assign bv_spray_entries = shop.metaobjects['spray_info'].values | default: empty
            assign bv_kit_products = prod.metafields.custom.sample_kit_products.value
            assign bv_max_price = 0
            if bv_kit_products != blank
              for bv_kit_prod in bv_kit_products
                assign bv_prod_max = 0
                for bv_kit_v in bv_kit_prod.variants
                  assign bv_kit_v_price = bv_kit_v.compare_at_price | default: 0
                  if bv_kit_v_price <= bv_kit_v.price
                    assign bv_kit_v_price = bv_kit_v.price
                  endif
                  if bv_kit_v_price > bv_prod_max
                    assign bv_prod_max = bv_kit_v_price
                  endif
                endfor
                assign bv_max_price = bv_max_price | plus: bv_prod_max
              endfor
            else
              for bv_v in prod.variants
                assign bv_v_price = bv_v.compare_at_price | default: 0
                if bv_v_price <= bv_v.price
                  assign bv_v_price = bv_v.price
                endif
                if bv_v_price > bv_max_price
                  assign bv_max_price = bv_v_price
                endif
              endfor
            endif
            assign bv_show_for = block.settings.show_for_sizes | strip
            assign bv_show_all = false
            if bv_show_for == blank
              assign bv_show_all = true
            else
              assign bv_show_sizes = bv_show_for | split: ','
            endif
          -%}

          {%- assign bv_variant_map = '{' -%}
          {%- assign bv_show_ids = '' -%}
          {%- assign bv_first = true -%}

          {%- for bv_v in prod.variants -%}
            {%- assign bv_spray = 0 -%}
            {%- assign bv_ref = bv_v.metafields.custom.spray_info -%}
            {%- if bv_ref and bv_ref.value -%}
              {%- assign bv_spray = bv_ref.value.sprays_count | default: 0 | plus: 0 -%}
            {%- endif -%}
            {%- if bv_spray == 0 and bv_spray_entries != empty -%}
              {%- assign bv_size_key = bv_v.title | downcase | strip -%}
              {%- for bv_entry in bv_spray_entries -%}
                {%- assign bv_entry_key = bv_entry.size | default: bv_entry.fields['size'].value | downcase | strip -%}
                {%- if bv_entry_key == bv_size_key -%}
                  {%- assign bv_spray = bv_entry.sprays_count | default: bv_entry.fields['sprays_count'].value | plus: 0 -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if bv_spray == 0 -%}
              {%- assign bv_vol = bv_v.title | remove: 'ml' | remove: 'ML' | strip | plus: 0 -%}
              {%- if bv_vol > 0 -%}{%- assign bv_spray = bv_vol | times: 10 -%}{%- endif -%}
            {%- endif -%}

            {%- if bv_show_all -%}
              {%- unless bv_show_ids == '' -%}{%- assign bv_show_ids = bv_show_ids | append: ',' -%}{%- endunless -%}
              {%- assign bv_show_ids = bv_show_ids | append: bv_v.id -%}
            {%- else -%}
              {%- assign bv_title_low = bv_v.title | downcase | strip | remove: ' ' -%}
              {%- assign bv_matches = false -%}
              {%- for bv_size in bv_show_sizes -%}
                {%- assign bv_size_clean = bv_size | strip | downcase | remove: ' ' -%}
                {%- if bv_title_low == bv_size_clean -%}
                  {%- assign bv_matches = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if bv_matches -%}
                {%- unless bv_show_ids == '' -%}{%- assign bv_show_ids = bv_show_ids | append: ',' -%}{%- endunless -%}
                {%- assign bv_show_ids = bv_show_ids | append: bv_v.id -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign bv_cap = bv_v.compare_at_price | default: 0 -%}
            {%- unless bv_first -%}{%- assign bv_variant_map = bv_variant_map | append: ',' -%}{%- endunless -%}
            {%- assign bv_variant_map = bv_variant_map
              | append: '"' | append: bv_v.id | append: '":'
              | append: '{"p":' | append: bv_v.price
              | append: ',"cap":' | append: bv_cap
              | append: ',"s":' | append: bv_spray
              | append: '}'
            -%}
            {%- assign bv_first = false -%}
          {%- endfor -%}
          {%- assign bv_variant_map = bv_variant_map | append: '}' -%}

          {%- assign bv_badge_text    = block.settings.badge_text    | default: 'הכי משתלם' -%}
          {%- assign bv_badge_star    = block.settings.badge_star -%}
          {%- assign bv_main_title    = block.settings.main_title -%}
          {%- assign bv_price_label   = block.settings.price_label   | default: 'רק' -%}
          {%- assign bv_savings_text  = block.settings.savings_text -%}
          {%- assign bv_right_bullet_1 = block.settings.right_bullet_1 | default: 'נסו לפני שמשקיעים בבקבוק מלא' -%}
          {%- assign bv_right_bullet_2 = block.settings.right_bullet_2 | default: 'ללא התחייבות, פשוט גלו' -%}
          {%- assign bv_right_bullet_3 = block.settings.right_bullet_3 -%}
          {%- assign bv_bottom_text_1  = block.settings.bottom_text_1 | default: 'מושלם לניסיון לפני רכישה' -%}
          {%- assign bv_bottom_text_2  = block.settings.bottom_text_2 | default: 'אידיאלי לנסיעות ושימוש יומיומי' -%}
          {%- assign bv_spray_label   = block.settings.spray_label   | default: 'ריסוסים' -%}
          {%- assign bv_spray_suffix  = block.settings.spray_suffix  | default: 'כלולים' -%}

          <div
            class="bv-block product__block product__block--medium"
            dir="rtl"
            data-bv-variants='{{ bv_variant_map }}'
            data-bv-max-price="{{ bv_max_price }}"
            data-bv-show-ids="{{ bv_show_ids }}"
            data-bv-show-all="{{ bv_show_all }}"
            style="display:none"
            {{ block.shopify_attributes }}
          >
            <div class="bv-inner">
              <div class="bv-top">

                <div class="bv-top-left">
                  <span class="bv-badge">{%- if bv_badge_star == true -%}★ {%- endif -%}{{ bv_badge_text }}</span>
                  {%- if bv_main_title != blank -%}
                    <p class="bv-main-title">{{ bv_main_title }}</p>
                  {%- else -%}
                    <p class="bv-main-title">נסו בושם יוקרתי שעולה כ-<span class="bv-ref-price">{{ bv_max_price | money_without_trailing_zeros }}</span></p>
                  {%- endif -%}
                  <div class="bv-price-row">
                    <span class="bv-price-label">{{ bv_price_label }}</span>
                    <strong class="bv-current-price"></strong>
                  </div>
                  {%- if bv_savings_text != blank -%}
                    <p class="bv-savings-text">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:middle;opacity:0.6;margin-inline-end:3px;"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                      {{ bv_savings_text }}
                    </p>
                  {%- endif -%}
                </div>

                <div class="bv-top-right">
                  <div class="bv-bullet">
                    <svg class="bv-bullet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/>
                    </svg>
                    <span>{{ bv_right_bullet_1 }}</span>
                  </div>
                  <div class="bv-bullet-sep"></div>
                  <div class="bv-bullet">
                    <svg class="bv-bullet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/>
                    </svg>
                    <span>{{ bv_right_bullet_2 }}</span>
                  </div>
                  {%- if bv_right_bullet_3 != blank -%}
                  <div class="bv-bullet-sep"></div>
                  <div class="bv-bullet">
                    <svg class="bv-bullet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/>
                    </svg>
                    <span>{{ bv_right_bullet_3 }}</span>
                  </div>
                  {%- endif -%}
                </div>

              </div>
              <div class="bv-bottom">
                <div class="bv-feature">
                  <img src="{{ 'spray.png' | asset_url }}" class="bv-spray-img" alt="" width="22" height="22">
                  <span>כ-<span class="bv-spray-count"></span> {{ bv_spray_label }}<br>{{ bv_spray_suffix }}</span>
                </div>
                <div class="bv-feature">
                  <svg class="bv-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/>
                  </svg>
                  <span>{{ bv_bottom_text_1 }}</span>
                </div>
                <div class="bv-feature">
                  <svg class="bv-travel-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="6" width="22" height="15" rx="2" ry="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="12" y1="12" x2="12" y2="16"/>
                    <line x1="10" y1="14" x2="14" y2="14"/>
                  </svg>
                  <span>{{ bv_bottom_text_2 }}</span>
                </div>
              </div>
            </div>
          </div>

          <style>
            .bv-block { margin: 0; }
            .bv-inner {
              border: 1.5px solid #e0d0b8;
              border-radius: 12px;
              overflow: hidden;
              background: #f7f2eb;
            }
            .bv-top {
              display: flex;
              border-bottom: 1px solid #e0d0b8;
            }
            .bv-top-left {
              flex: 1.8;
              padding: 14px 16px;
              border-inline-start: 1px solid #e0d0b8;
            }
            .bv-badge {
              display: inline-block;
              background: #1c1008;
              color: #f0e8d5;
              font-size: 9px;
              font-weight: 700;
              letter-spacing: .05em;
              padding: 3px 8px;
              border-radius: 4px;
              margin-bottom: 6px;
            }
            .bv-main-title {
              font-size: 17px;
              font-weight: 700;
              color: #1c1008;
              margin: 0 0 3px;
              line-height: 1.2;
            }
            .bv-ref-line {
              font-size: 13px;
              color: #9a8878;
              margin: 2px 0 6px;
              line-height: 1.3;
            }
            .bv-ref-price-full {
              color: #B8860B;
              font-weight: 700;
            }
            .bv-price-row {
              display: flex;
              align-items: baseline;
              gap: 6px;
              margin: 0;
            }
            .bv-current-price {
              color: #B8860B;
              font-size: 30px;
              font-weight: 700;
              letter-spacing: -0.01em;
            }
            .bv-savings-text {
              font-size: 10px;
              color: #9a8878;
              margin: 4px 0 0;
              line-height: 1.3;
            }
            .bv-top-right {
              flex: 1;
              padding: 12px 12px;
              display: flex;
              flex-direction: column;
              justify-content: center;
              gap: 8px;
            }
            .bv-bullet {
              display: flex;
              flex-direction: row;
              align-items: flex-start;
              gap: 7px;
              font-size: 11px;
              color: #1c1008;
              line-height: 1.35;
            }
            .bv-bullet-icon {
              width: 22px;
              height: 22px;
              color: #1a6b35;
              flex-shrink: 0;
              margin-top: 1px;
            }
            .bv-bottom {
              display: flex;
              padding: 8px 0;
            }
            .bv-feature {
              flex: 1;
              display: flex;
              flex-direction: row;
              align-items: center;
              text-align: right;
              padding: 0 10px;
              font-size: 11px;
              color: #1c1008;
              line-height: 1.35;
              gap: 7px;
            }
            .bv-feature + .bv-feature { border-inline-start: 1px solid #e0d0b8; }
            .bv-spray-img {
              width: 26px;
              height: 26px;
              object-fit: contain;
              opacity: 0.75;
              flex-shrink: 0;
            }
            .bv-check-icon {
              width: 24px;
              height: 24px;
              color: #1a6b35;
              flex-shrink: 0;
            }
            .bv-travel-icon {
              width: 24px;
              height: 24px;
              color: #1a6b35;
              flex-shrink: 0;
            }
            @media (max-width: 480px) {
              .bv-top-left { padding: 8px 10px; }
              .bv-top-right { padding: 8px 10px; gap: 6px; }
              .bv-main-title { font-size: 15px; }
              .bv-feature { font-size: 10px; padding: 0 6px; gap: 5px; }
            }
          </style>

          <script>
            (function () {
              function bvInit(block) {
                var variants = JSON.parse(block.getAttribute('data-bv-variants') || '{}');
                var showIds  = (block.getAttribute('data-bv-show-ids') || '').split(',').filter(Boolean);
                var showAll  = block.getAttribute('data-bv-show-all') === 'true';

                function fmt(cents) {
                  return '₪' + (cents / 100).toFixed(2).replace('.', '.');
                }

                function getForm() {
                  return block.closest('form')
                      || document.querySelector('form[action="/cart/add"]')
                      || document.querySelector('form[action*="/cart/add"]');
                }

                function getVid() {
                  var form = getForm();
                  var scope = form || document;
                  var el = scope.querySelector('[data-variant-select]')
                          || scope.querySelector('select[name="id"]')
                          || scope.querySelector('input[name="id"]:checked')
                          || scope.querySelector('input[name="id"]');
                  return el ? el.value : null;
                }

                function update() {
                  var vid  = getVid();
                  var data = vid ? variants[vid] : null;

                  if (!data || (!showAll && showIds.indexOf(vid) === -1)) {
                    block.style.display = 'none';
                    return;
                  }
                  block.style.display = 'block';

                  block.querySelector('.bv-current-price').textContent = fmt(data.p);
                  block.querySelector('.bv-spray-count').textContent   = data.s || 0;
                }

                update();
                var _form = getForm();
                if (_form) _form.addEventListener('change', update);
                var _varSel = (_form || document).querySelector('[data-variant-select]');
                if (_varSel) _varSel.addEventListener('change', update);
                document.addEventListener('product:variant-change', update);
              }

              function ready(fn) {
                if (document.readyState !== 'loading') { fn(); }
                else { document.addEventListener('DOMContentLoaded', fn); }
              }

              ready(function () {
                document.querySelectorAll('.bv-block').forEach(bvInit);
              });
            })();
          </script>

        {%- endif -%}

    {%- endcase -%}
  {% endif %}
{%- endfor -%}
