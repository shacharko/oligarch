        "text_Dknewh": {
          "type": "text",
          "settings": {
            "text": "<p><strong>ריחות יוצאי דופן, יוקרתיים ומקוריים שמובילים אתכם למסע אישי ומסתורי.תנו לעצמכם להיסחף – כל תו, כל ניחוח, כל מארז מזמין אתכם לגלות עולם שאין שני לו.התחילו עכשיו את החוויה – כיבואן הרשמי של Zoologist Perfumes בישראל, אנחנו מביאים את הבשמים האותנטיים ישירות אליכם.</strong></p>",
            "text_font_class": "fs-body-100"
          }
        },
        "subheading_iMFGaV": {
