        "text_q7Ctmk": {
          "type": "text",
          "settings": {
            "text": "<h4><strong>בשמים נישתיים שמספרים סיפור כל בקבוק הוא חוויה חושית ייחודית</strong></h4>",
            "text_font_class": "fs-body-100"
